<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="view-transition" content="same-origin" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlightManager.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="page-aurora" aria-hidden="true"></div>
    <header class="app-header" id="appHeader">
        <nav class="app-nav" aria-label="Main navigation">
            <ul class="nav-links" id="navPill">
                <li><a asp-controller="Home" asp-action="Index">Flights</a></li>
                <li><a asp-controller="Home" asp-action="BestOffers">Offers</a></li>
                <li><a asp-controller="Home" asp-action="Privacy">Insights</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li><a asp-controller="Flights" asp-action="Index">Flights admin</a></li>
                    <li><a asp-controller="Reservations" asp-action="Index">Reservations</a></li>
                }
                <li class="nav-pill-cursor" aria-hidden="true"></li>
            </ul>
            <partial name="_LoginPartial" />
        </nav>
    </header>

    <div class="app-shell">
        <main role="main">
            @if (TempData["Error"] != null)
            {
                <div class="status-alert error" role="alert">
                    <span>@TempData["Error"]</span>
                    <button type="button" class="alert-dismiss" aria-label="Dismiss">&times;</button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="status-alert success" role="status">
                    <span>@TempData["Success"]</span>
                    <button type="button" class="alert-dismiss" aria-label="Dismiss">&times;</button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="footer-links">
            <span>Aviation intelligence powered by real-time data.</span>
            <div class="footer-legal">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span>·</span>
                <a href="https://opensky-network.org" target="_blank" rel="noopener">Data: OpenSky</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
